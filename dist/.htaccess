<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # If the request matches an actual file or directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise, hand off to index.html so React Router can handle the route
  RewriteRule ^ index.html [L]
</IfModule>

# Optional but recommended: prevent caching of index.html so users
# always get your latest deployed build
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>